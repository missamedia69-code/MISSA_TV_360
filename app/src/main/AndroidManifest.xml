<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lecture reseau (catalogues Pages + streaming) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice input provided by Leanback SearchSupportFragment. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Telechargement des fichiers de jeu -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Installation d'APK (jeux telechargeables) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Compatible Android TV et appareils tactiles ; l'application garde une entrée dans les deux lanceurs. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MissaTv"
        tools:targetApi="33"
        tools:ignore="MissingApplicationIcon">

        <!-- FileProvider : installe les APK telecharges depuis le cache prive -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Écran d'accueil : visible depuis les lanceurs Android classiques et Android TV. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran Extensions : dépôts + installation des plugins de contenu.
             Non exporté : seul le parcours interne de l'app y accède. -->
        <activity
            android:name=".extensions.ExtensionsActivity"
            android:exported="false"
            android:label="@string/extensions_title"
            android:theme="@style/Theme.MissaTv.Extensions" />

        <!-- Écran « Jeux vidéo » : catalogue des jeux téléchargeables -->
        <activity
            android:name=".games.GamesActivity"
            android:exported="false" />

        <!-- Lecteur vidéo (Media3 ExoPlayer) — thème AppCompat requis
             (PlayerActivity extends AppCompatActivity) -->
        <activity
            android:name=".playback.PlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.MissaTv.Player"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>
</manifest>
