<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_disabled_bg" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/missa_border" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_secondary_bg_focused" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/missa_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_secondary_bg" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/btn_secondary_stroke" />
        </shape>
    </item>
</selector>
