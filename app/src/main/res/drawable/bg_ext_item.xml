<?xml version="1.0" encoding="utf-8"?>
<!-- Fond des lignes de l'écran Extensions : surface normale, bordure jaune
     au focus (navigation télécommande oblige). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/missa_surface_elevated" />
            <stroke
                android:width="2dp"
                android:color="@color/missa_yellow" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/missa_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/missa_surface_elevated" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
