<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_disabled_bg" />
            <corners android:radius="@dimen/missa_radius_sm" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/missa_surface_elevated" />
            <stroke android:width="2dp" android:color="@color/missa_yellow_focus" />
            <corners android:radius="@dimen/missa_radius_sm" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/missa_surface_elevated" />
            <stroke android:width="2dp" android:color="@color/missa_yellow_focus" />
            <corners android:radius="@dimen/missa_radius_sm" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/btn_secondary_bg_focused">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/missa_surface" />
                    <corners android:radius="@dimen/missa_radius_sm" />
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/missa_surface" />
            <stroke android:width="1dp" android:color="@color/missa_border" />
            <corners android:radius="@dimen/missa_radius_sm" />
        </shape>
    </item>
</selector>
