<?xml version="1.0" encoding="utf-8"?>
<!-- Focus visible pour les éléments textuels focalisables à la télécommande
     (ex. « ‹ Retour »). Sans cela, aucun retour visuel au focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_secondary_bg_focused" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/missa_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
