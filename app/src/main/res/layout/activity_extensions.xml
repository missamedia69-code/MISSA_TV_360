<?xml version="1.0" encoding="utf-8"?>
<!-- Écran Extensions : dépôts + liste des extensions publiées.
     Construit pour la télécommande : tout est focusable, aucun geste requis. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/missa_bg_top"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/extensions_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/extensions_title"
        android:textColor="@color/missa_white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/extensions_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="24dp"
        android:textColor="@color/missa_yellow"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/extensions_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_primary"
            android:focusable="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/extensions_add_repo"
            android:textColor="@color/missa_bg_top"
            android:textStyle="bold" />

        <Button
            android:id="@+id/extensions_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_btn_secondary"
            android:focusable="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/extensions_refresh"
            android:textColor="@color/missa_white" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/extensions_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="32dp" />

</LinearLayout>
