<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/games_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_missa_night"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/games_back"
            style="@style/MissaButton.Secondary"
            android:layout_width="wrap_content"
            android:text="@string/player_back" />

        <TextView
            style="@style/MissaText.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/row_games" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/games_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/games_status_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/games_status"
            style="@style/MissaText.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite" />

        <ProgressBar
            android:id="@+id/games_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:max="100"
            android:progressTint="@color/missa_yellow"
            android:visibility="gone" />

        <Button
            android:id="@+id/games_cancel"
            style="@style/MissaButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/games_cancel"
            android:visibility="gone" />

        <Button
            android:id="@+id/games_retry"
            style="@style/MissaButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/games_retry"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
