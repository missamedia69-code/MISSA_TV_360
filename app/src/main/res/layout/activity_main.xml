<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_missa_night">

    <FrameLayout
        android:id="@+id/main_browse_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Branded loading state shown until the remote or fallback catalogue is ready. -->
    <LinearLayout
        android:id="@+id/catalog_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
android:background="@drawable/bg_missa_night"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/missa_yellow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/catalog_loading"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:fontFamily="sans"
            android:letterSpacing="0.02"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/missa_yellow"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>

</FrameLayout>
