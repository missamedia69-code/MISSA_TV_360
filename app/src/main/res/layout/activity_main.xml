<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_missa_night">

    <FrameLayout
        android:id="@+id/main_browse_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/catalog_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="24dp"
        android:background="@drawable/bg_status_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite">

        <TextView
            android:id="@+id/catalog_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="520dp"
            android:textColor="@color/missa_text"
            android:textSize="@dimen/text_meta" />

        <Button
            android:id="@+id/catalog_retry"
            style="@style/MissaButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/catalog_retry"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/catalog_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_missa_night"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/missa_yellow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/catalog_loading"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/missa_yellow"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>
</FrameLayout>
