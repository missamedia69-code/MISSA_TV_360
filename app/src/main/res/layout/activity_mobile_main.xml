<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_missa_night">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/catalog_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_status_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite">

            <TextView
                android:id="@+id/catalog_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/missa_text"
                android:textSize="@dimen/text_meta" />

            <Button
                android:id="@+id/catalog_retry"
                style="@style/MissaButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/catalog_retry"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/main_browse_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/catalog_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_missa_night"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/missa_yellow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/catalog_loading"
            android:textColor="@color/missa_white"
            android:textSize="20sp" />
    </LinearLayout>
</FrameLayout>
