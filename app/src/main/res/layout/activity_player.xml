<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Visuel de fond (utilisé en mode audio : radio / podcast) -->
    <ImageView
        android:id="@+id/player_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        android:keepScreenOn="true" />

    <!-- Titre réel du contenu, visible quelques secondes puis estompé
         (ne masque jamais durablement la vidéo ni les contrôles). -->
    <TextView
        android:id="@+id/player_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="24dp"
        android:maxWidth="760dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:background="@drawable/bg_player_title"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/missa_white"
        android:visibility="gone" />

</FrameLayout>
