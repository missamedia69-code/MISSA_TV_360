<?xml version="1.0" encoding="utf-8"?>
<!-- Carte MISSA : visuel + un seul libellé (sous l'image, lisible à 3 m).
     L'ancien titre superposé à l'image doublait le libellé : supprimé. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_marginStart="@dimen/card_gap"
    android:layout_marginEnd="@dimen/card_gap">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/card_image"
            android:layout_width="@dimen/card16_w"
            android:layout_height="@dimen/card16_h"
            android:background="@drawable/bg_card_image"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/badge_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_badge_live"
            android:text="@string/badge_live"
            android:textColor="@color/missa_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:visibility="gone" />

        <!-- Progression de lecture : piste translucide + barre jaune,
             posée en bas de l'image (coins du bas arrondis par l'anneau). -->
        <ProgressBar
            android:id="@+id/card_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_h"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressBackgroundTint="#66FFFFFF"
            android:progressTint="@color/missa_yellow"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- Anneau de focus jaune : fond posé par MissaCardPresenter au focus. -->
        <View
            android:id="@+id/card_focus_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/card_title"
        android:layout_width="@dimen/card16_w"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/card_title_size"
        android:textColor="@color/missa_text_secondary" />

    <TextView
        android:id="@+id/card_subtitle"
        android:layout_width="@dimen/card16_w"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textColor="@color/missa_text_muted_on_dark"
        android:visibility="gone" />
</LinearLayout>
