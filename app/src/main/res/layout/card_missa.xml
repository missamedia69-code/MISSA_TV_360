<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_marginStart="@dimen/card_gap"
    android:layout_marginEnd="@dimen/card_gap">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_focus"
        android:clipChildren="false"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/card_image"
            android:layout_width="@dimen/card16_w"
            android:layout_height="@dimen/card16_h"
            android:background="@drawable/bg_card_image"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/badge_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_live"
            android:importantForAccessibility="no"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/badge_live"
            android:textColor="@color/missa_white"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/card_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_h"
            android:layout_gravity="bottom"
            android:importantForAccessibility="no"
            android:progressTint="@color/missa_yellow"
            android:visibility="gone" />

        <View
            android:id="@+id/card_focus_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/card_title"
        android:layout_width="@dimen/card16_w"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/text_content_title"
        android:textColor="@color/missa_text_secondary" />

    <TextView
        android:id="@+id/card_subtitle"
        android:layout_width="@dimen/card16_w"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="@dimen/text_caption"
        android:textColor="@color/missa_text_muted"
        android:visibility="gone" />
</LinearLayout>
