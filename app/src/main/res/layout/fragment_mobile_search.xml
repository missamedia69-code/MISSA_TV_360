<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_missa_night"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/mobile_search_back"
            style="@style/MissaButton.Secondary"
            android:layout_width="wrap_content"
            android:text="@string/mobile_back" />

        <TextView
            style="@style/MissaText.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/search_title" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/mobile_search_query"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/search_film_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/missa_white"
            android:textColorHint="@color/missa_text_muted"
            android:textSize="@dimen/text_body" />

        <ImageButton
            android:id="@+id/mobile_search_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="@string/mobile_clear"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            android:visibility="gone" />

        <Button
            android:id="@+id/mobile_search_submit"
            style="@style/MissaButton.Primary"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/search_submit" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/mobile_search_progress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminateTint="@color/missa_yellow"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mobile_search_status"
            style="@style/MissaText.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite" />

        <Button
            android:id="@+id/mobile_search_retry"
            style="@style/MissaButton.Secondary"
            android:layout_width="wrap_content"
            android:text="@string/catalog_retry"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mobile_search_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
