<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne d'extension / de dépôt dans l'écran Extensions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_ext_item"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ext_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/missa_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ext_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/missa_white"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ext_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:textColor="@color/missa_yellow"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
