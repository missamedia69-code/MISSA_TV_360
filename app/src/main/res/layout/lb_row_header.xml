<?xml version="1.0" encoding="utf-8"?>
<!-- Surcharge de lb_row_header (leanback) : icône de catégorie à GAUCHE du
     titre de rangée. L'icône reste sœur de row_header (BrowseFragment la
     retrouve via parent.findViewById). Les IDs row_header et
     row_header_description sont requis par RowHeaderPresenter. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/row_header_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="8dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <androidx.leanback.widget.RowHeaderView
        android:id="@+id/row_header"
        android:importantForAccessibility="no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?rowHeaderStyle" />

    <TextView
        android:id="@+id/row_header_description"
        android:importantForAccessibility="no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        style="?rowHeaderDescriptionStyle" />

</LinearLayout>
