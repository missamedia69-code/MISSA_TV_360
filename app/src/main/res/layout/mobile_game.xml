<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_status_panel"
    android:gravity="center_vertical"
    android:minHeight="148dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.missa.tv360.ui.mobile.RatioImageView
        android:id="@+id/mobile_game_image"
        android:layout_width="128dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mobile_game_title"
            style="@style/MissaText.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/mobile_game_description"
            style="@style/MissaText.Metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/mobile_game_status"
            style="@style/MissaText.Metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <ProgressBar
            android:id="@+id/mobile_game_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressTint="@color/missa_yellow"
            android:visibility="gone" />

        <Button
            android:id="@+id/mobile_game_action"
            style="@style/MissaButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/games_download" />
    </LinearLayout>
</LinearLayout>
