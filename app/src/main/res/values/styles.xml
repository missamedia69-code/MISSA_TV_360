<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MissaButton.Primary" parent="android:style/Widget.Material.Button">
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="MissaButton.Secondary" parent="android:style/Widget.Material.Button">
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="MissaText.ScreenTitle">
        <item name="android:textColor">@color/missa_white</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="MissaText.SectionTitle">
        <item name="android:textColor">@color/missa_white</item>
        <item name="android:textSize">@dimen/text_section_title</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="MissaText.Body">
        <item name="android:textColor">@color/missa_text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
    <style name="MissaText.Metadata">
        <item name="android:textColor">@color/missa_text_muted</item>
        <item name="android:textSize">@dimen/text_meta</item>
    </style>
</resources>
