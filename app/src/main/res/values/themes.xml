<?xml version="1.0" encoding="utf-8"?>
<!-- Thème TV sombre dérivé de la palette du logo :
     fond navy, jaune pour le focus, bleu/vert pour les accents. -->
<resources>

    <!-- AppCompat est requis par le prototype Cloudstream ; les fragments et
         attributs Leanback de l'accueil TV sont conservés. -->
    <style name="Theme.MissaTv" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_missa_night</item>
        <item name="android:colorPrimary">@color/missa_yellow</item>
        <item name="android:colorAccent">@color/missa_yellow</item>
        <item name="colorPrimary">@color/missa_yellow</item>
        <item name="colorAccent">@color/missa_yellow</item>
        <item name="defaultBrandColor">@color/missa_blue</item>
        <item name="browsePaddingStart">@dimen/tv_browse_padding_start</item>
        <item name="browsePaddingEnd">@dimen/tv_browse_padding_end</item>
        <item name="browsePaddingTop">@dimen/tv_browse_padding_top</item>
        <item name="browsePaddingBottom">@dimen/tv_browse_padding_bottom</item>
        <item name="browseRowsMarginStart">@dimen/tv_browse_rows_margin_start</item>
        <item name="browseRowsMarginTop">@dimen/tv_browse_rows_margin_top</item>
        <item name="browseRowsFadingEdgeLength">@dimen/tv_browse_rows_fading_edge</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Barres système discrètes et sombres (restent lisibles sur fond bleu nuit) -->
        <item name="android:statusBarColor">@color/missa_navy_deep</item>
        <item name="android:navigationBarColor">@color/missa_navy_deep</item>
    </style>

    <!-- Expérience tactile : même identité, composants Material Android natifs. -->
    <style name="Theme.MissaTv.Mobile" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_missa_night</item>
        <item name="android:colorAccent">@color/missa_yellow</item>
        <item name="colorPrimary">@color/missa_yellow</item>
        <item name="colorAccent">@color/missa_yellow</item>
        <item name="android:textColorPrimary">@color/missa_white</item>
        <item name="android:textColorSecondary">@color/missa_text_secondary</item>
        <item name="android:statusBarColor">@color/missa_navy_deep</item>
        <item name="android:navigationBarColor">@color/missa_navy_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- PlayerActivity extends AppCompatActivity => thème dérivé d'AppCompat
         obligatoire (Theme.Leanback ne l'est pas) -->
    <style name="Theme.MissaTv.Player" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:colorAccent">@color/missa_yellow</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <!-- Overview (écran de détails) -->
    <style name="MissaDetailsOverviewSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Écran Extensions : activité AppCompat (boîtes de dialogue et champ de
         saisie AppCompat exigent un thème AppCompat, Theme.Leanback n'en est pas
         un). Palette identique au reste de l'application. -->
    <style name="Theme.MissaTv.Extensions" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_missa_night</item>
        <item name="colorPrimary">@color/missa_yellow</item>
        <item name="colorAccent">@color/missa_yellow</item>
        <item name="android:textColorPrimary">@color/missa_white</item>
        <item name="android:textColorSecondary">@color/missa_white</item>
    </style>

</resources>
