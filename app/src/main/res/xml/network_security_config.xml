<?xml version="1.0" encoding="utf-8"?>
<!-- Les extensions Cloudstream appellent des sites tiers, dont certains n'ont que du HTTP.
     Le HTTPS reste utilise quand le site le propose ; le HTTP clair est tolere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
